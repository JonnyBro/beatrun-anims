$bonemerge "ValveBiped.Bip01_L_Foot"
$bonemerge "ValveBiped.Bip01_L_Toe0"


$sectionframes 30 119

$poseparameter "lean_roll" -60 60 loop 0
$poseparameter "swing" -90 90 loop 0
$poseparameter "run_pose" -60 100 loop 0
$poseparameter "rope_yaw" -90 90 loop 0
$poseparameter "rope_pitch" -90 90 loop 0
$poseparameter "hang_yaw" -179 179 loop 0
$poseparameter "hang_pitch" -90 90 loop 0
$poseparameter "hurt" 0 90 loop 0
$poseparameter "water_yaw" -90 90 loop 0
$poseparameter "water_pitch" -90 90 loop 0
$poseparameter "move_y" -1 1 loop 0
$poseparameter "move_x" -1 1 loop 0

$ikchain "rhand" "ValveBiped.Bip01_R_Hand" knee 0.707 0.707 0
$ikchain "lhand" "ValveBiped.Bip01_L_Hand" knee 0.707 0.707 0
$ikchain "rfoot" "ValveBiped.Bip01_R_Foot" knee 0.707 -0.707 0
$ikchain "lfoot" "ValveBiped.Bip01_L_Foot" knee 0.707 -0.707 0

$ikautoplaylock "rfoot" 1 0.1
$ikautoplaylock "lfoot" 1 0.1

$sequence "climb1" {
	"climbanim_anims\climb1.smd"
	fadein 0.2
	fadeout 0.2
	snap
	fps 55
	ikrule "rhand" release contact 0 fakeorigin 0 0 0 fakerotate 0 0 0 floor 0 height 0 radius 0 range 0 0 40 40 target 0
	ikrule "lhand" release contact 0 fakeorigin 0 0 0 fakerotate 0 0 0 floor 0 height 0 radius 0 range 0 0 40 40 target 1
	ikrule "rfoot" release contact 0 fakeorigin 0 0 0 fakerotate 0 0 0 floor 0 height 0 radius 0 range 0 0 40 40 target 2
