$sequence "hangpose" {
	"climbanim_anims\hangpose.smd"
	"climbanim_anims\hangpose_2.smd"
	"climbanim_anims\hangpose_3.smd"
	"climbanim_anims\hangpose_4.smd"
	"climbanim_anims\hangpose_5.smd"
	"climbanim_anims\hangpose_6.smd"
	"climbanim_anims\hangpose_7.smd"
	"climbanim_anims\hangpose_8.smd"
	"climbanim_anims\hangpose_9.smd"
	"climbanim_anims\hangpose_10.smd"
	"climbanim_anims\hangpose_11.smd"
	"climbanim_anims\hangpose_12.smd"
	"climbanim_anims\hangpose_13.smd"
	"climbanim_anims\hangpose_14.smd"
	"climbanim_anims\hangpose_15.smd"
	blend "hang_pitch" -90 90
	blend "hang_yaw" -179 179
	blendwidth 3
	fadein 0.75
	fadeout 1
	fps 30
	loop
	ikrule "rhand" release contact 0 fakeorigin 0 0 0 fakerotate 0 0 0 floor 0 height 0 radius 0 range 0 0 1 1 target 0
	ikrule "lhand" release contact 0 fakeorigin 0 0 0 fakerotate 0 0 0 floor 0 height 0 radius 0 range 0 0 1 1 target 1
